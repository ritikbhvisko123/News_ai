# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Real News APIs (the app automatically aggregates rich live RSS feeds
# from Dainik Bhaskar, Free Press Journal Indore, The Hindu, BBC Hindi, NDTV, Times of India, TechCrunch, etc.)
# If you provide any of these API keys, the server will also merge their results.
GNEWS_API_KEY=""
NEWS_API_KEY=""
NEWSDATA_API_KEY=""
